# Copy to .env.local and fill in. Never commit real keys.

# Public site URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.theactivesolutions.com

# Contact address (server-only). The site never prints it: visitors see a "Click to reveal"
# button. Used by the forms and emails. Defaults to hello@theactivesolutions.com.
# (NEXT_PUBLIC_CONTACT_EMAIL still works as a fallback.)
CONTACT_EMAIL=hello@theactivesolutions.com

# --- Contact, meeting and newsletter forms (POST /api/contact) -------------
# Required server-only CRM settings for all forms. Never use NEXT_PUBLIC_ for the key.
CRM_BASE_URL=https://crm.theactivesolutions.com/
CRM_SITE_API_KEY=

# Server-only SMTP settings for contact, partner, meeting and newsletter notifications.
# Use your Active Solutions mailbox credentials. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Notification recipients. Comma-separate multiple addresses.
# Falls back to CONTACT_TO_EMAIL, then CONTACT_EMAIL.
ADMIN_EMAIL=hello@theactivesolutions.com
CONTACT_TO_EMAIL=

# Optional sender override; defaults to "The Active Solutions" <SMTP_USER>.
CONTACT_FROM_EMAIL=

# --- Blog (/insights) from WordPress ----------------------------------------
# REST API of the WordPress site the articles are written in.
WORDPRESS_API_URL=https://blogs.theactivesolutions.com/wp-json/wp/v2

# Optional. Published posts are public, so these are NOT needed. Only set them if the
# REST API is locked down; use a WordPress application password, never the login password.
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Optional. Lets WordPress refresh the blog instantly instead of within 5 minutes:
# POST https://www.theactivesolutions.com/api/revalidate?secret=<this value>
WORDPRESS_REVALIDATE_SECRET=
