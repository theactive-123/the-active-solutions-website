# Copy to .env.local and fill in. Never commit real keys.

# Public site URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.theactivesolutions.com

# Public contact address shown on the site and used for mailto: fallbacks
# (defaults to hello@theactivesolutions.com).
NEXT_PUBLIC_CONTACT_EMAIL=hello@theactivesolutions.com

# --- Contact, meeting and newsletter forms (POST /api/contact) -------------
# Resend API key (https://resend.com/api-keys). When unset, the API answers 503
# and the forms show a friendly "email us instead" fallback with a mailto: link.
RESEND_API_KEY=

# Where form submissions are delivered. Comma-separate several addresses.
# Falls back to NEXT_PUBLIC_CONTACT_EMAIL / site.email.
CONTACT_TO_EMAIL=

# Sender. Must be on a domain verified in Resend, e.g.
# "The Active Solutions <forms@theactivesolutions.com>".
# Falls back to "The Active Solutions <onboarding@resend.dev>" (Resend's test sender,
# which only delivers to the Resend account owner's address).
CONTACT_FROM_EMAIL=

# --- Meeting booking (/contact/schedule) ------------------------------------
# Optional Calendly / Cal.com link. When set, the booking page shows a
# "Prefer Calendly?" link next to the built-in date & time picker.
NEXT_PUBLIC_BOOKING_URL=

# --- Blog (/insights) from WordPress ----------------------------------------
# REST API of the WordPress site the articles are written in.
WORDPRESS_API_URL=https://blogs.theactivesolutions.com/wp-json/wp/v2

# Optional. Published posts are public, so these are NOT needed. Only set them if the
# REST API is locked down; use a WordPress application password, never the login password.
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Optional. Lets WordPress refresh the blog instantly instead of within 5 minutes:
# POST https://www.theactivesolutions.com/api/revalidate?secret=<this value>
WORDPRESS_REVALIDATE_SECRET=
